[Unit]
Description=ETEC306: start Wi-Fi setup mode if no Wi-Fi connects within 60 s of boot
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for i in $(seq 1 60); do [ "$(nmcli -t -f DEVICE,STATE dev | grep ^wlan0: | cut -d: -f2)" = connected ] && exit 0; [ "$(nmcli -t -f DEVICE,STATE dev | grep ^eth0: | cut -d: -f2)" = connected ] && exit 0; sleep 1; done; systemctl start --no-block etec306-wifi-setup.service'

[Install]
WantedBy=multi-user.target
