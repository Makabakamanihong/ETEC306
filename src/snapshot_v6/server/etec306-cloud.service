[Unit]
Description=ETEC306 cloud logger (MQTT -> JSONL + images)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/home/opc/etec306
ExecStart=/usr/bin/python3 /home/opc/etec306/etec306_cloud.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
